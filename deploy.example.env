# Copy to deploy.env and fill in your server (deploy.env is gitignored).
# Used by scripts/setup_vps_sync.sh and scripts/publish_data.sh.

# SSH target for one-shot setup from your laptop
IMDB_DEPLOY_HOST=root@your.server.example

# Where the built static site lives on the server (must contain index.html)
IMDB_DOCROOT=/var/www/example.com/imdb

# Optional: app checkout on the server (default /opt/imdb-wrapped)
# IMDB_APP_PATH=/opt/imdb-wrapped

# Optional: sync log on the server
# IMDB_SYNC_LOG=/var/log/imdb-wrapped-sync.log
